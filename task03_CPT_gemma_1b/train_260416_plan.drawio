        <mxCell id="s1_goal" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;paddingLeft=10;" value="核心目標：&lt;br&gt;1. 強制推開 gate_fft / gate_mem&lt;br&gt;2. 建立『訊號 vs 噪聲』辨識力&lt;br&gt;3. 激活梯度強心針 (register_hook)" vertex="1">
